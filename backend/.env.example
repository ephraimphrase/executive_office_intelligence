# ============================================================
# EOIS Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_NAME=EOIS
APP_ENV=development  # development | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql+asyncpg://eois_user:eois_password@db:5432/eois_db
DATABASE_URL_SYNC=postgresql://eois_user:eois_password@db:5432/eois_db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Microsoft Azure / Entra ID
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
MS_GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0
MS_GRAPH_SCOPES=https://graph.microsoft.com/.default

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Azure AI Search (Vector DB)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-azure-search-admin-key
AZURE_SEARCH_INDEX=eois-documents

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=eois-documents

# WhatsApp Business (Meta)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_VERSION=v20.0

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your-openweathermap-api-key
GVP_LOCATION_LAT=6.5244
GVP_LOCATION_LON=3.3792
GVP_LOCATION_NAME=Lagos

# Briefing Generation
BRIEFING_GENERATION_HOUR=6
BRIEFING_GENERATION_MINUTE=0
BRIEFING_TIMEZONE=Africa/Lagos

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Polling
EMAIL_POLL_INTERVAL_SECONDS=300
CALENDAR_SYNC_INTERVAL_SECONDS=600
ONEDRIVE_SYNC_INTERVAL_SECONDS=1800

# GVP Configuration
GVP_EMAIL=gvp@dangote.com
GVP_NAME=Group Vice President
GVP_TIMEZONE=Africa/Lagos
